# MedMinder environment variables
# Copy to .env and fill in real values.
# NEVER commit .env — it is git-ignored.

# Runtime environment: development | production
ENV=development

# Database connection string (not used in Phase 0, but wired for Phase 1)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medminder

# Allowed CORS origins (comma-separated for production)
CORS_ORIGINS=["http://localhost:5173"]

# Frontend API base URL (used by the Vite dev server)
VITE_API_BASE_URL=http://localhost:8000

# --- Reminders / Web Push (Phase 7) ---
# Generate a key pair with: python scripts/generate_vapid_keys.py
# Public key is served to the browser; the PRIVATE key is a SECRET —
# never commit it or log it. Leave both empty to disable push delivery
# (reminders are still recorded and visible in-app).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID "sub" claim — an operator contact (mailto: or https:)
VAPID_SUBJECT=mailto:admin@example.com

# Whether the in-process reminder scheduler starts with the app.
# Off in tests/CI/Alembic; on by default otherwise.
REMINDERS_ENABLED=true
# Optional dispatch tuning (sane defaults shown):
# REMINDER_TICK_SECONDS=30
# REMINDER_GRACE_MINUTES=15
# REMINDER_SEND_MAX_ATTEMPTS=3
